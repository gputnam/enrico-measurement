# MC-only reco-level columns (truth matching, systematic inputs), read from MasterAnaDev.
mc_run           mc_run
mc_subrun        mc_subrun
mc_evt           mc_nthEvtInFile
had_tm_pdg       MasterAnaDev_hadron_tm_PDGCode[:3]
had_tm_beginKE   MasterAnaDev_hadron_tm_beginKE[:3]
had_tm_fraction  MasterAnaDev_hadron_tm_fraction[:3]
had_tm_destruct  MasterAnaDev_hadron_tm_destructCode[:3]
t_reco_good_obj  truth_reco_hasGoodObjects
t_reco_good_vtx  truth_reco_isGoodVertex
t_reco_fv_smear  truth_reco_isFidVol_smeared
t_improved_michel truth_improved_michel_electron
# recoil response uncertainties per particle category (lateral systematics)
rerr_em                  part_response_recoil_passive_em_id_err
rerr_meson               part_response_recoil_passive_meson_id_err
rerr_proton              part_response_recoil_passive_proton_id_err
rerr_low_proton          part_response_recoil_passive_low_proton_id_err
rerr_mid_proton          part_response_recoil_passive_mid_proton_id_err
rerr_high_proton         part_response_recoil_passive_high_proton_id_err
rerr_low_neutron         part_response_recoil_passive_low_neutron_id_err
rerr_mid_neutron         part_response_recoil_passive_mid_neutron_id_err
rerr_high_neutron        part_response_recoil_passive_high_neutron_id_err
rerr_other               part_response_recoil_passive_other_id_err
rerr_xtalk               part_response_recoil_passive_xtalk_id_err
rerr_all_em              part_response_recoil_allNonMuonClusters_em_id_err
rerr_all_meson           part_response_recoil_allNonMuonClusters_meson_id_err
rerr_all_proton          part_response_recoil_allNonMuonClusters_proton_id_err
rerr_all_low_proton      part_response_recoil_allNonMuonClusters_low_proton_id_err
rerr_all_mid_proton      part_response_recoil_allNonMuonClusters_mid_proton_id_err
rerr_all_high_proton     part_response_recoil_allNonMuonClusters_high_proton_id_err
rerr_all_low_neutron     part_response_recoil_allNonMuonClusters_low_neutron_id_err
rerr_all_mid_neutron     part_response_recoil_allNonMuonClusters_mid_neutron_id_err
rerr_all_high_neutron    part_response_recoil_allNonMuonClusters_high_neutron_id_err
rerr_all_other           part_response_recoil_allNonMuonClusters_other_id_err
rerr_all_xtalk           part_response_recoil_allNonMuonClusters_xtalk_id_err
rpass_em                 part_response_recoil_passive_em_id
rpass_meson              part_response_recoil_passive_meson_id
rpass_proton             part_response_recoil_passive_proton_id
rpass_other              part_response_recoil_passive_other_id
rpass_low_neutron        part_response_recoil_passive_low_neutron_id
rpass_mid_neutron        part_response_recoil_passive_mid_neutron_id
rpass_high_neutron       part_response_recoil_passive_high_neutron_id
rpass_xtalk              part_response_recoil_passive_xtalk_id
